@page "/cotacoes/nova"
@page "/cotacoes/{Id:guid}/editar"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CotacaoService Service
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Nova Cotação</PageTitle>
<section class="page-content form-page"><Steps Current="Step" OnChange="IrPara"/>@if(!string.IsNullOrWhiteSpace(Error)){<div class="alert error">@Error</div>}<div class="form-card">
@if(Step==0){<div class="section-heading"><h2>Dados da Cotação</h2><p>Identifique o cliente e as condições comerciais.</p></div><div class="form-grid"><Field Label="Cliente *"><input @bind="Form.Cliente" @bind:event="oninput" placeholder="Digite ou selecione o cliente"/></Field><Field Label="Destino *"><input @bind="Form.Destino" @bind:event="oninput" placeholder="Cidade ou local de destino"/></Field><Field Label="Origem *"><input @bind="Form.Origem" @bind:event="oninput" placeholder="País de origem"/></Field><Field Label="Câmbio (USD → BRL) *"><DecimalInput @bind-Value="Form.Cambio" Placeholder="Ex.: 5,49" /></Field><Field Label="Data da Cotação *"><DateInput @bind-Value="Form.DataCotacao" /></Field><Field Label="Modelo do PDF *"><select @bind="Form.ModeloPdf"><option value="@ModeloPdf.FullBeauty">Full Beauty</option><option value="@ModeloPdf.FullPharma">Full Pharma</option></select></Field></div>}
@if(Step==1){<div class="section-heading row"><div><h2>Modelos e Itens</h2><p>Cada modelo aceita exatamente um item e um único fornecedor.</p></div><button class="button secondary" @onclick="AdicionarModelo">＋ Adicionar modelo</button></div><div class="models-list">@foreach(var modelo in Form.Modelos){<section class="model-card" @key="modelo.Id"><div class="model-header"><strong>Modelo @(Form.Modelos.IndexOf(modelo)+1)</strong><button class="icon-button danger" disabled="@(Form.Modelos.Count==1)" @onclick="()=>RemoverModelo(modelo)">×</button></div><div class="form-grid"><Field Label="Nome do modelo *"><input @bind="modelo.Nome" @bind:event="oninput" placeholder="Ex.: Frasco âmbar 100 ml"/></Field><Field Label="Código interno do fornecedor *"><input @bind="modelo.CodigoFornecedor" @bind:event="oninput" placeholder="Código interno"/></Field></div>@if(!modelo.ItemAdicionado){<button class="button secondary add-item" @onclick="()=>modelo.ItemAdicionado=true">＋ Adicionar item</button>}else{<div class="item-box"><div class="item-title"><strong>Item único deste modelo</strong><button class="text-button danger-text" @onclick="()=>modelo.ItemAdicionado=false">Remover item</button></div><div class="form-grid item-grid"><Field Label="Produto *"><input @bind="modelo.Item.Descricao" @bind:event="oninput"/></Field><Field Label="Código do produto *"><input @bind="modelo.Item.Codigo" @bind:event="oninput"/></Field><Field Label="NCM *"><input @bind="modelo.Item.Ncm" @bind:event="oninput" placeholder="0000.00.00"/></Field><Field Label="Quantidade *"><input @bind="modelo.Item.Quantidade" type="number" min="0.01"/></Field><Field Label="Material"><input @bind="modelo.Item.Material"/></Field><Field Label="Tamanho"><input @bind="modelo.Item.Tamanho"/></Field><Field Label="Especificação"><input @bind="modelo.Item.Especificacao"/></Field><Field Label="Capacidade"><input @bind="modelo.Item.Capacidade"/></Field><Field Label="Preço unitário (USD) *"><input @bind="modelo.Item.PrecoUnitarioUsd" type="number" min="0" step="0.01"/></Field></div></div>}</section>}</div>}
@if(Step==2){<div class="section-heading"><h2>Custos e Impostos por Item</h2><p>Cada NCM possui suas próprias alíquotas. Preencha os percentuais do item correspondente.</p></div><div class="tax-items">@foreach(var modelo in Form.Modelos.Where(x=>x.ItemAdicionado)){<ImpostosItemEditor Modelo="modelo" />}</div><div class="section-heading commercial-heading"><h2>Condições gerais da cotação</h2><p>Estes valores são aplicados depois da soma de todos os itens.</p></div><div class="form-grid"><Field Label="Despesas adicionais (R$)"><input @bind="Form.DespesasAdicionaisReais" type="number" min="0" step="0.01"/></Field><Field Label="Margem sobre o custo total (%)"><input @bind="Form.MargemPercentual" type="number" min="0" step="0.01"/></Field></div>}
@if(Step==3){<div class="section-heading"><h2>Resumo para conferência</h2><p>O fornecedor foi retirado desta prévia porque pode variar entre os modelos.</p></div><ResumoValores Cotacao="Form"/><div class="summary-items"><h3>Modelos da Cotação</h3>@foreach(var m in Form.Modelos.Where(x=>x.ItemAdicionado)){<div class="summary-item"><div><strong>@m.Nome</strong><span>@m.Item.Descricao · NCM @m.Item.Ncm · @m.Item.Quantidade unidade(s)</span></div><strong>@((m.Item.Quantidade*m.Item.PrecoUnitarioUsd).ToString("C",Usd))</strong></div>}</div>}
@if(Step==4){<div class="section-heading"><h2>Finalizar</h2><p>A cotação será salva e o PDF poderá ser gerado no modelo escolhido.</p></div><div class="finish-card"><strong>@(Form.ModeloPdf==ModeloPdf.FullBeauty?"Full Beauty":"Full Pharma")</strong><span>@Form.Modelos.Count(x=>x.ItemAdicionado) modelo(s) preenchido(s)</span></div>}
<div class="form-actions"><button class="button secondary" disabled="@(Step==0)" @onclick="()=>Step--">← Voltar</button>@if(Step<4){<button class="button primary" @onclick="Continuar">Continuar →</button>}else{<button class="button primary" @onclick="Salvar">Salvar Cotação</button>}</div></div></section>
@code { [Parameter] public Guid? Id{get;set;} Cotacao Form=new(); int Step; string Error=""; string DataTexto {get=>Form.DataCotacao.ToString("yyyy-MM-dd");set{if(DateOnly.TryParse(value,out var d))Form.DataCotacao=d;}} static CultureInfo Usd=>CultureInfo.GetCultureInfo("en-US"); protected override void OnInitialized(){if(Id.HasValue)Form=Service.Obter(Id.Value)??new();} void AdicionarModelo()=>Form.Modelos.Add(new()); void RemoverModelo(ModeloCotacao m)=>Form.Modelos.Remove(m); void IrPara(int s){if(s<=Step){Step=s;Error="";}else Continuar();} void Continuar(){Error=Validar();if(Error=="")Step=Math.Min(4,Step+1);} string Validar(){if(Step==0&&(string.IsNullOrWhiteSpace(Form.Cliente)||string.IsNullOrWhiteSpace(Form.Destino)||string.IsNullOrWhiteSpace(Form.Origem)||Form.Cambio<=0))return "Preencha todos os dados obrigatórios da cotação.";if(Step==1&&(Form.Modelos.Count==0||Form.Modelos.Any(m=>string.IsNullOrWhiteSpace(m.Nome)||string.IsNullOrWhiteSpace(m.CodigoFornecedor)||!m.ItemAdicionado||string.IsNullOrWhiteSpace(m.Item.Descricao)||string.IsNullOrWhiteSpace(m.Item.Codigo)||string.IsNullOrWhiteSpace(m.Item.Ncm)||m.Item.Quantidade<=0)))return "Cada modelo deve ter nome, código de fornecedor e exatamente um item completo, incluindo o NCM.";return "";} async Task Salvar(){for(var s=0;s<2;s++){Step=s;var e=Validar();if(e!=""){Error=e;return;}}var auth=await AuthenticationStateProvider.GetAuthenticationStateAsync();var idTexto=auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;Guid? usuarioId=Guid.TryParse(idTexto,out var id)?id:null;Service.Salvar(Form,usuarioId);Nav.NavigateTo($"/cotacoes/{Form.Id}/resumo");}}
