<div class="filters-bar">
    <label class="search-field"><span>⌕</span><input @bind="Numero" @bind:event="oninput" placeholder="Filtrar por número da cotação" /></label>
    <select class="filter-select" @bind="Status"><option value="">Todos os status</option>@foreach(var status in StatusCotacao.Todos){<option value="@status">@status</option>}</select>
</div>
<CotacoesTabela Cotacoes="Filtradas" />

@code {
    [Parameter] public IEnumerable<Cotacao> Cotacoes { get; set; } = [];
    [Parameter] public int? MaxResults { get; set; }
    private string Numero { get; set; } = string.Empty;
    private string Status { get; set; } = string.Empty;
    private IEnumerable<Cotacao> Filtradas
    {
        get
        {
            var resultado = Cotacoes.Where(x =>
                (string.IsNullOrWhiteSpace(Numero) || x.Numero.Contains(Numero.Trim(), StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(Status) || x.Status == Status));
            return MaxResults.HasValue ? resultado.Take(MaxResults.Value) : resultado;
        }
    }
}
