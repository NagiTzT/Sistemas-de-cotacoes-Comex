<div class="steps" aria-label="Etapas da cotação">@for(var i=0;i<Labels.Length;i++){var n=i;<button type="button" class="step @(Current==i?"current":Current>i?"done":"")" aria-label="@($"{i+1} {Labels[i]}")" aria-current="@(Current==i?"step":null)" title="@Labels[i]" @onclick="()=>OnChange.InvokeAsync(n)"><span class="step-icon">@(i+1)</span><span>@Labels[i]</span></button>}</div>
@code { static readonly string[] Labels=["Dados da Cotação","Modelos e Itens","Custos e Impostos","Informações do PDF","Prévia e Fotos","Finalizar"]; [Parameter] public int Current{get;set;} [Parameter] public EventCallback<int> OnChange{get;set;} }
