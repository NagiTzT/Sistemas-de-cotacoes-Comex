<dl class="summary-list"><div><dt>FOB Total (USD)</dt><dd>@Cotacao.FobTotalUsd.ToString("C",Usd)</dd></div><div><dt>Valor convertido</dt><dd>@Cotacao.FobTotalReais.ToString("C",Pt)</dd></div><div><dt>Impostos calculados por item/NCM</dt><dd>@Cotacao.TotalImpostosReais.ToString("C",Pt)</dd></div><div><dt>Despesas adicionais</dt><dd>@Cotacao.DespesasAdicionaisReais.ToString("C",Pt)</dd></div><div class="total"><dt>Custo total</dt><dd>@Cotacao.CustoTotalReais.ToString("C",Pt)</dd></div><div class="total"><dt>Preço de venda sugerido</dt><dd>@Cotacao.PrecoVendaSugeridoReais.ToString("C",Pt)</dd></div><div><dt>Margem aplicada sobre o custo total</dt><dd class="positive">@Cotacao.MargemPercentual.ToString("N2")%</dd></div></dl>
@code{[Parameter,EditorRequired]public Cotacao Cotacao{get;set;}=default!;static CultureInfo Pt=>CultureInfo.GetCultureInfo("pt-BR");static CultureInfo Usd=>CultureInfo.GetCultureInfo("en-US");}
