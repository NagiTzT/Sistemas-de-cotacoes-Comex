<article class="kpi-card"><div class="kpi-icon @Tone"><LucideIcon Name="@(Tone == "green" ? "send" : Tone == "amber" ? "briefcase-business" : "trending-up")" /></div><div class="kpi-label">@Label</div><div class="kpi-value">@Value</div><div class="kpi-detail">@Detail</div></article>
@code { [Parameter] public string Icon{get;set;}="◆";[Parameter] public string Tone{get;set;}="";[Parameter] public string Label{get;set;}="";[Parameter] public string Value{get;set;}="";[Parameter] public string Detail{get;set;}=""; }
