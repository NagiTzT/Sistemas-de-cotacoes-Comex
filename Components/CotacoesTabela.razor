@inject CotacaoService Service
@if (!Cotacoes.Any()) { <div class="empty-state"><div class="empty-icon">▤</div><h3>Nenhuma cotação encontrada</h3><p>Crie a primeira cotação para começar.</p><a class="button primary" href="cotacoes/nova">＋ Nova Cotação</a></div> } else { <div class="table-wrap"><table><thead><tr><th>Número</th><th>Cliente</th><th>Modelos</th><th>Data</th><th>Valor</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var c in Cotacoes){<tr @key="c.Id"><td><a class="number" href="cotacoes/@c.Id/resumo">#@c.Numero</a></td><td>@c.Cliente</td><td>@c.Modelos.Count(x=>x.ItemAdicionado)</td><td>@c.DataCotacao.ToString("dd/MM/yyyy")</td><td>@c.PrecoVendaSugeridoReais.ToString("C", Pt)</td><td><select class="status-select" value="@c.Status" @onchange="e=>MudarStatus(c,e.Value?.ToString())">@foreach(var status in StatusCotacao.Todos){<option value="@status">@status</option>}</select></td><td><a class="edit-link" title="Editar cotação" aria-label="Editar cotação @c.Numero" href="cotacoes/@c.Id/editar">✎</a></td></tr>}</tbody></table></div> }
@code { [Parameter] public IEnumerable<Cotacao> Cotacoes {get;set;}=[]; static CultureInfo Pt=>CultureInfo.GetCultureInfo("pt-BR"); void MudarStatus(Cotacao c,string? status){if(string.IsNullOrWhiteSpace(status))return;c.Status=status;Service.AtualizarStatus(c.Id,status);} }
